# Copy to server/.env (never commit the real file)
NODE_ENV=development
PORT=4000
# Browser origin(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-in-development
# Leave empty in development to use embedded Postgres (PGlite) stored in server/.data
# Production: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# OpenRouteService API key (free). Without it, delivery quotes go to manual review.
ORS_API_KEY=
# Development only: pretend every address is this many km away (never use in production)
DISTANCE_MOCK_KM=
