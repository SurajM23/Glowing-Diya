# Copy to server/.env (never commit the real file)
NODE_ENV=development
PORT=4000
# Browser origin(s) allowed to call the API directly, comma separated. Needed for local dev
# (Vite on 5173) and only matters in production if something other than the server's own
# built-in client (see DEPLOYMENT.md) calls the API from a browser.
CLIENT_ORIGIN=http://localhost:5173
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-in-development
# Leave empty in development to use embedded Postgres (PGlite) stored in server/.data
# Production: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Optional. The shop ships with a flat delivery fee (set in Admin > Settings > Delivery) and does
# not need this. Set ORS_API_KEY (OpenRouteService, free) only if you switch to per-km pricing by
# clearing the flat fee — without a key, per-km quotes then go to manual review instead.
ORS_API_KEY=
# Development only: pretend every address is this many km away (never use in production)
DISTANCE_MOCK_KM=
